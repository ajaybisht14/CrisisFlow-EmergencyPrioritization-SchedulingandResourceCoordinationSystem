# Copy values into your PowerShell environment; do not commit real secrets.
CRISISFLOW_DB_HOST=localhost
CRISISFLOW_DB_PORT=3306
CRISISFLOW_DB_NAME=crisisflow_v2
CRISISFLOW_DB_USER=root
CRISISFLOW_DB_PASSWORD=change-me
CRISISFLOW_PORT=8080
CRISISFLOW_AUTO_INTERVAL=30
# Set a long random value to protect write endpoints and location ingestion.
CRISISFLOW_API_KEY=replace-with-long-random-secret
# Optional OSRM-compatible routing base URL. Default public OSRM demo has no traffic data.
CRISISFLOW_ROUTING_URL=https://router.project-osrm.org
